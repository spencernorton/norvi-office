<?xml version="1.0" encoding="UTF-8"?>
<ooo:color-table xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
                 xmlns:ooo="http://openoffice.org/2004/office">
  <draw:color draw:name="Paper" draw:color="#FFFFFF"/>
  <draw:color draw:name="Subtle fill" draw:color="#F3F3F3"/>
  <draw:color draw:name="Table fill" draw:color="#E6E6E6"/>
  <draw:color draw:name="Divider" draw:color="#BEBEBE"/>
  <draw:color draw:name="Muted ink" draw:color="#656565"/>
  <draw:color draw:name="Charcoal" draw:color="#2C2C2C"/>
  <draw:color draw:name="Ink" draw:color="#272727"/>
</ooo:color-table>
